from fastapi import FastAPI, HTTPException, Depends
from fastapi.middleware.cors import CORSMiddleware
from contextlib import asynccontextmanager
from typing import List, Optional
import uvicorn
import os

from .models import *

# Global model state
models = {}

@asynccontextmanager
async def lifespan(app: FastAPI):
    # --- STARTUP ---
    # Load model files if detected
    {% if model_file %}
    print("Loading model from {{ model_file }}...")
    # TODO: Implement actual loading logic based on framework
    # if "{{ framework }}" == "sklearn":
    #     import joblib
    #     models["main"] = joblib.load("{{ model_file }}")
    models["main"] = {"status": "loaded", "framework": "{{ framework }}"}
    {% endif %}
    yield
    # --- SHUTDOWN ---
    models.clear()

app = FastAPI(
    title="{{ repo_name }} API",
    description="Production-ready API generated by ContextForge.",
    version="1.0.0",
    lifespan=lifespan
)

# Enable CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "framework": "{{ framework }}",
        "model_loaded": "main" in models
    }

{% for ep in entry_points %}
@app.post("{{ api_prefix }}/{{ ep.function_name }}", response_model=PredictResponse)
async def {{ ep.function_name }}(request: {{ ep.function_name.capitalize() }}Request):
    """
    {{ ep.description or "Run inference using " + ep.function_name }}
    """
    try:
        # result = models["main"].{{ ep.function_name }}(**request.dict())
        return PredictResponse(
            status="success",
            function="{{ ep.function_name }}",
            result={"prediction": "mock_result_from_{{ ep.function_name }}"}
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
{% endfor %}

if __name__ == "__main__":
    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)
