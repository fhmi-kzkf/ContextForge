version: '3.8'

services:
  {{ service_name or "contextforge-api" }}:
    build: .
    ports:
      - "{{ port or 8000 }}:{{ port or 8000 }}"
    {% if model_volume %}
    volumes:
      - ./models:/app/models
    {% endif %}
    environment:
      - ENV=production
      - LOG_LEVEL=info
    restart: always
