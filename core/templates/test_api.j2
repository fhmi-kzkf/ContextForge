@pytest.mark.asyncio
async def test_{{ ep.function_name }}_valid_payload():
    async with AsyncClient(app=app, base_url="http://test") as ac:
        # Mocking a payload based on detected args
        payload = {
            {% for arg in ep.args %}
            {% if arg != 'self' %}
            "{{ arg }}": 0, # Mock value
            {% endif %}
            {% endfor %}
        }
        response = await ac.post("{{ api_prefix }}/{{ ep.function_name }}", json=payload)
    assert response.status_code == 200
    assert response.json()["status"] == "success"

@pytest.mark.asyncio
async def test_{{ ep.function_name }}_missing_field():
    async with AsyncClient(app=app, base_url="http://test") as ac:
        # Empty payload to trigger 422
        response = await ac.post("{{ api_prefix }}/{{ ep.function_name }}", json={})
    # If the function has required arguments, FastAPI returns 422
    assert response.status_code == 422

@pytest.mark.asyncio
async def test_{{ ep.function_name }}_wrong_type():
    async with AsyncClient(app=app, base_url="http://test") as ac:
        # Passing a string where maybe a number is expected (FastAPI validation)
        payload = {
            {% for arg in ep.args %}
            {% if arg != 'self' %}
            "{{ arg }}": "should_be_number_maybe", 
            {% endif %}
            {% endfor %}
        }
        response = await ac.post("{{ api_prefix }}/{{ ep.function_name }}", json=payload)
    # This might return 200 if type is Any, but we'll try to trigger validation
    # For a robust template, we'll just check if it handles bad inputs
    assert response.status_code in [200, 422]
